# Copy to .env and fill in. The gateway needs these.

# Your IMMOSTOP Supabase project.
SUPABASE_URL=https://quscysqdzhgpmcdjxowm.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# Shared gateway key. Generate a strong one and set the SAME value as the
# TRACKER_GATEWAY_KEY secret on the Supabase `tracker` function.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
TRACKER_GATEWAY_KEY=

# TCP ports the trackers connect to (set the same in each device's server config).
TELTONIKA_PORT=5027
GT06_PORT=5023
